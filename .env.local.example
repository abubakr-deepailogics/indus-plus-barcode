# Copy to .env.local (or .env.development / .env.production) and fill in.
# Never commit real values.

# ── Databases (server-only) ──────────────────────────────────────────────
MSSQL_INDUS_PLUS_CONNECTION_STRING=
MSSQL_PIT_SYSTEM_CONNECTION_STRING=
MSSQL_HRMS_CONNECTION_STRING=

# ── Auth ─────────────────────────────────────────────────────────────────
# Long random string used to sign session cookies.
SESSION_SECRET=

# ── QR image scanner backend (qr-scanner-backend/) ───────────────────────
QR_SCANNER_URL=

# ── Logging & tracing (see docs/logging.md) — all optional ───────────────
# debug | info | warn | error. Default: info in production, debug in dev.
LOG_LEVEL=
# json | pretty (console only; files are always JSON). Default: json in production, pretty in dev.
LOG_FORMAT=
# Write logs/app-*.log, logs/error-*.log, logs/audit-*.log. Default: true.
LOG_TO_FILE=
# Log directory. Default: ./logs (relative to the app's working directory).
LOG_DIR=
# Days to keep app/error logs. Default: 14.
LOG_RETENTION_DAYS=
# Days to keep audit logs. Default: 365.
LOG_AUDIT_RETENTION_DAYS=
# DB queries slower than this (ms) are logged as warnings with their SQL. Default: 1000.
LOG_SLOW_QUERY_MS=
# Requests slower than this (ms) are logged as warnings. Default: 3000.
LOG_SLOW_REQUEST_MS=
# Lowest browser log level shipped to the server (debug | info | warn | error). Default: warn.
NEXT_PUBLIC_CLIENT_LOG_LEVEL=

# ── Build ────────────────────────────────────────────────────────────────
# Alternate build output dir (used by `npm run prod:side`). Default: .next
NEXT_DIST_DIR=
